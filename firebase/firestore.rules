rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function coupleDoc(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && request.auth.uid in coupleDoc(coupleId).memberIds;
    }

    function isCouplePartner(uid) {
      return signedIn()
        && uid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId
            == get(/databases/$(database)/documents/users/$(uid)).data.coupleId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId != null;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isCouplePartner(uid);
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['coupleId', 'createdAt']);
      allow delete: if signedIn()
        && exists(/databases/$(database)/documents/couples/$(resource.data.coupleId))
        && request.auth.uid in coupleDoc(resource.data.coupleId).memberIds;
    }

    match /couples/{coupleId} {
      allow get: if isCoupleMember(coupleId);
      allow create: if signedIn()
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn() && (
        isCoupleMember(coupleId)
        || (
          resource.data.memberIds.size() < 2
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() <= 2
        )
      );
      allow delete: if isCoupleMember(coupleId);

      match /dates/{dateId} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }
  }
}
